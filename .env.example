# PRJ-03: ClinicaGuard Configuration
CLINICAGUARD_ENV=development

# PostgreSQL + pgvector Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinicaguard_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
USE_LOCAL_VECTOR_FALLBACK=true

# MLflow Tracking URI (Local SQLite / directory)
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=ClinicaGuard-Readmission-Prediction

# Clinical Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
